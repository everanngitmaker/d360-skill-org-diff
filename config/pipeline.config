# Pipeline promotion order
# Defines the required sequence for feature branches before they can be merged to each target.
# (Used by the deploy pipeline; included here so both skills share one config format.)
PROMOTION_ORDER=dev,stage,prod

# Maps each org alias to its corresponding branch name (used by 4-compare.sh).
# Format: <org-alias>:<branch>,<org-alias>:<branch>,...
# Replace these placeholders with your own authenticated org aliases (see `sf org list`).
ORG_BRANCH_MAP="your-dev-alias:dev,your-stage-alias:stage,your-prod-alias:prod"
